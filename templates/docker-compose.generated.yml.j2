{{ header }}
name: {{ stack.project_name }}

services:
{% if stack.services.litellm.enabled %}
  litellm:
    image: {{ stack.images.litellm }}
    container_name: dgx-litellm
    restart: unless-stopped
{% if stack.services.litellm.auth_enabled | default(true) %}
    env_file:
      - ${DGX_ENV_FILE:-.env}
{% endif %}
    command:
      - "--config"
      - "/app/config.yaml"
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "{{ stack.services.litellm.internal_port }}"
    volumes:
      - ./litellm.config.yaml:/app/config.yaml:ro
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          python -c 'import urllib.request; urllib.request.urlopen("http://127.0.0.1:{{ stack.services.litellm.internal_port }}/v1/models", timeout=3).read()'
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 10s
{% if stack.services.litellm.expose_host %}
    ports:
      - "{{ stack.network.bind_ip }}:{{ stack.services.litellm.host_port }}:{{ stack.services.litellm.internal_port }}"
{% endif %}
    networks:
      {{ stack.network.name }}:
        aliases:
          - litellm
{% endif %}

networks:
  {{ stack.network.name }}:
    name: {{ stack.network.name }}
    external: true
