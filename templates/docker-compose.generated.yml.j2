{{ header }}
name: {{ stack.project_name }}

services:
{% if stack.services.traefik.enabled %}
  traefik:
    image: {{ stack.images.traefik }}
    container_name: dgx-traefik
    restart: unless-stopped
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.file.filename=/etc/traefik/dynamic.yml"
      - "--entrypoints.web.address=:80"
{% if stack.services.traefik.dashboard %}
      - "--api.dashboard=true"
{% endif %}
    ports:
      - "{{ stack.network.bind_ip }}:{{ stack.services.traefik.host_port }}:80"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik-dynamic.yml:/etc/traefik/dynamic.yml:ro
    networks:
      {{ stack.network.name }}:
        aliases:
          - {{ stack.domain.litellm }}
{% endif %}

{% if stack.services.litellm.enabled %}
  litellm:
    image: {{ stack.images.litellm }}
    container_name: dgx-litellm
    restart: unless-stopped
{% if stack.services.litellm.auth_enabled | default(true) %}
    env_file:
      - ${DGX_ENV_FILE:-.env}
{% endif %}
    command:
      - "--config"
      - "/app/config.yaml"
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "{{ stack.services.litellm.internal_port }}"
    volumes:
      - ./litellm.config.yaml:/app/config.yaml:ro
{% if stack.services.litellm.expose_host %}
    ports:
      - "{{ stack.network.bind_ip }}:{{ stack.services.litellm.host_port }}:{{ stack.services.litellm.internal_port }}"
{% endif %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.litellm.rule=Host(`{{ stack.domain.litellm }}`)"
      - "traefik.http.routers.litellm.entrypoints=web"
      - "traefik.http.services.litellm.loadbalancer.server.port={{ stack.services.litellm.internal_port }}"
    depends_on:
{% for model in models %}
      - {{ model.container_name }}
{% endfor %}
    networks:
      - {{ stack.network.name }}
{% endif %}

{% if stack.services.openwebui.enabled %}
  open-webui:
    image: {{ stack.images.openwebui }}
    container_name: open-webui
    restart: unless-stopped
    env_file:
      - ${DGX_ENV_FILE:-.env}
    environment:
      ENABLE_OPENAI_API: "true"
      OPENAI_API_BASE_URL: "http://litellm:{{ stack.services.litellm.internal_port }}/v1"
      OPENAI_API_BASE_URLS: "http://litellm:{{ stack.services.litellm.internal_port }}/v1"
{% if stack.services.litellm.auth_enabled | default(true) %}
      OPENAI_API_KEY: "${LITELLM_MASTER_KEY}"
      OPENAI_API_KEYS: "${LITELLM_MASTER_KEY}"
{% else %}
      OPENAI_API_KEY: "not-needed"
      OPENAI_API_KEYS: "not-needed"
{% endif %}
      BYPASS_MODEL_ACCESS_CONTROL: "{{ stack.services.openwebui.bypass_model_access_control | string | lower }}"
{% if first_chat_model %}
      DEFAULT_MODELS: "{{ first_chat_model }}"
{% endif %}
    volumes:
      - open-webui-data:/app/backend/data
    extra_hosts:
      - "host.docker.internal:host-gateway"
      - "{{ stack.domain.base }}:{{ stack.network.bind_ip }}"
      - "{{ stack.domain.openwebui }}:{{ stack.network.bind_ip }}"
      - "{{ stack.domain.grafana }}:{{ stack.network.bind_ip }}"
      - "{{ stack.domain.searxng }}:{{ stack.network.bind_ip }}"
{% if stack.services.openwebui.expose_host %}
    ports:
      - "{{ stack.network.bind_ip }}:{{ stack.services.openwebui.host_port }}:{{ stack.services.openwebui.internal_port }}"
{% endif %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.openwebui.rule=Host(`{{ stack.domain.openwebui }}`){% if stack.domain.base is defined and stack.domain.base != stack.domain.openwebui %} || Host(`{{ stack.domain.base }}`){% endif %}"
      - "traefik.http.routers.openwebui.entrypoints=web"
      - "traefik.http.services.openwebui.loadbalancer.server.port={{ stack.services.openwebui.internal_port }}"
    depends_on:
      - litellm
    networks:
      - {{ stack.network.name }}
{% endif %}

{% for model in models %}
  {{ model.container_name }}:
    image: {{ model.image | default(stack.images.vllm_default) }}
{% if model.pull_policy is defined %}
    pull_policy: {{ model.pull_policy }}
{% endif %}
    container_name: {{ model.container_name }}
    restart: unless-stopped
    gpus: all
    ipc: host
    shm_size: "64g"
    ulimits:
      memlock: -1
      stack: 67108864
    env_file:
      - ${DGX_ENV_FILE:-.env}
    environment:
      HF_TOKEN: "${HF_TOKEN:-}"
      HF_HOME: /root/.cache/huggingface
      NCCL_IGNORE_CPU_AFFINITY: "1"
    command:
{{ model.command | yaml(6) }}
    volumes:
      - "{{ stack.paths.hf_cache }}:/root/.cache/huggingface"
      - "{{ stack.paths.vllm_cache }}:/root/.cache/vllm"
      - "{{ stack.paths.flashinfer_cache }}:/root/.cache/flashinfer"
      - "{{ stack.paths.triton_cache }}:/root/.triton"
      - ./chat-templates:/workspace/vllm/chat-templates:ro
{% if model.routing.expose_host %}
    ports:
      - "{{ stack.network.bind_ip }}:{{ model.routing.host_port }}:{{ model.routing.internal_port }}"
{% endif %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: {{ model.gpu.device_ids | json }}
              capabilities: ["gpu"]
    networks:
      - {{ stack.network.name }}

{% endfor %}
{% if stack.services.prometheus.enabled %}
  prometheus:
    image: {{ stack.images.prometheus }}
    container_name: dgx-prometheus
    restart: unless-stopped
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=7d"
      - "--web.enable-lifecycle"
    volumes:
      - prometheus-data:/prometheus
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus-vllm-targets.yml:/etc/prometheus/targets/vllm.yml:ro
{% if stack.services.prometheus.expose_host %}
    ports:
      - "{{ stack.network.bind_ip }}:{{ stack.services.prometheus.host_port }}:{{ stack.services.prometheus.internal_port }}"
{% endif %}
    networks:
      - {{ stack.network.name }}
{% endif %}

{% if stack.services.grafana.enabled %}
  grafana:
    image: {{ stack.images.grafana }}
    container_name: dgx-grafana
    restart: unless-stopped
    env_file:
      - ${DGX_ENV_FILE:-.env}
    environment:
      GF_SECURITY_ADMIN_USER: "${GRAFANA_ADMIN_USER:-admin}"
      GF_SECURITY_ADMIN_PASSWORD: "${GRAFANA_ADMIN_PASSWORD}"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_USERS_DEFAULT_THEME: system
      GF_DASHBOARDS_MIN_REFRESH_INTERVAL: "1s"
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
{% if stack.services.grafana.expose_host %}
    ports:
      - "{{ stack.network.bind_ip }}:{{ stack.services.grafana.host_port }}:{{ stack.services.grafana.internal_port }}"
{% endif %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.grafana.rule=Host(`{{ stack.domain.grafana }}`)"
      - "traefik.http.routers.grafana.entrypoints=web"
      - "traefik.http.services.grafana.loadbalancer.server.port={{ stack.services.grafana.internal_port }}"
    depends_on:
      - prometheus
    networks:
      - {{ stack.network.name }}
{% endif %}

{% if stack.services.exporters.enabled %}
  node-exporter:
    image: {{ stack.images.node_exporter }}
    container_name: dgx-node-exporter
    restart: unless-stopped
    pid: host
    command:
      - "--web.listen-address=:9100"
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/host"
      - "--collector.filesystem.mount-points-exclude=^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+|var/lib/containers/storage/.+)($|/)"
      - "--collector.filesystem.fs-types-exclude=^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|mqueue|nsfs|overlay|proc|pstore|rpc_pipefs|securityfs|sysfs|tracefs)$"
    read_only: true
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host:ro,rslave
    networks:
      - {{ stack.network.name }}

  cadvisor:
    image: {{ stack.images.cadvisor }}
    container_name: dgx-cadvisor
    restart: unless-stopped
    privileged: true
    healthcheck:
      disable: true
    command:
      - "--port=8089"
    devices:
      - /dev/kmsg:/dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro
    networks:
      - {{ stack.network.name }}

  gpu-exporter:
    build:
      context: ./gpu-exporter
    image: dgx-gpu-exporter:local
    container_name: dgx-gpu-exporter
    restart: unless-stopped
    gpus: all
    environment:
      NVIDIA_VISIBLE_DEVICES: all
      NVIDIA_DRIVER_CAPABILITIES: compute,utility
      GPU_EXPORTER_LISTEN_ADDR: 0.0.0.0
      GPU_EXPORTER_PORT: 9400
    volumes:
      - /usr/bin/nvidia-smi:/usr/bin/nvidia-smi:ro
    networks:
      - {{ stack.network.name }}
{% endif %}

{% if stack.services.browserless.enabled %}
  browserless:
    image: {{ stack.images.browserless }}
    container_name: browserless
    restart: unless-stopped
{% if stack.services.browserless.expose_host %}
    ports:
      - "{{ stack.network.bind_ip }}:{{ stack.services.browserless.host_port }}:{{ stack.services.browserless.internal_port }}"
{% endif %}
    networks:
      - {{ stack.network.name }}
{% endif %}

{% if stack.services.searxng.enabled %}
  searxng:
    image: {{ stack.images.searxng }}
    container_name: searxng-core
    restart: unless-stopped
    env_file:
      - ${DGX_ENV_FILE:-.env}
    environment:
      SEARXNG_BASE_URL: "http://{{ stack.domain.searxng }}/"
      SEARXNG_SECRET_KEY: "${SEARXNG_SECRET_KEY}"
    volumes:
      - ./searxng:/etc/searxng:ro
      - searxng-core-data:/var/cache/searxng
{% if stack.services.searxng.expose_host %}
    ports:
      - "{{ stack.network.bind_ip }}:{{ stack.services.searxng.host_port }}:{{ stack.services.searxng.internal_port }}"
{% endif %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.searxng.rule=Host(`{{ stack.domain.searxng }}`)"
      - "traefik.http.routers.searxng.entrypoints=web"
      - "traefik.http.services.searxng.loadbalancer.server.port={{ stack.services.searxng.internal_port }}"
    depends_on:
      - searxng-valkey
    networks:
      - {{ stack.network.name }}

  searxng-valkey:
    image: {{ stack.images.valkey }}
    container_name: searxng-valkey
    restart: unless-stopped
    command: ["valkey-server", "--save", "30", "1", "--loglevel", "warning"]
    volumes:
      - searxng-valkey-data:/data
    networks:
      - {{ stack.network.name }}
{% endif %}

networks:
  {{ stack.network.name }}:
    name: {{ stack.network.name }}

volumes:
  open-webui-data:
    name: {{ stack.services.openwebui.volume_name }}
  prometheus-data:
    name: {{ stack.services.prometheus.volume_name }}
  grafana-data:
    name: {{ stack.services.grafana.volume_name }}
  searxng-core-data:
    name: {{ stack.services.searxng.core_volume_name }}
  searxng-valkey-data:
    name: {{ stack.services.searxng.valkey_volume_name }}
